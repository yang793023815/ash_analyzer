#---------------------------------------------------------------------
# 通用表解析 (schema.前缀 / 同义词兜底) → LK_FULL / LK_COLS
#---------------------------------------------------------------------
lookup_table() {
  local v="$1" res vowner vtab
  vowner=""; vtab="$v"
  case "$v" in *.*) vowner="${v%%.*}"; vtab="${v##*.}";; esac
  # 1) 直接按名找 (owner 优先级: 指定 > 当前schema > SYS > 其他)
  res=$(qsql "set heading off feedback off pages 0 verify off define off
select nm from (
  select c.owner||'.'||c.table_name nm,
         row_number() over (order by
            case when c.owner = upper('$vowner') then 0
                 when c.owner = sys_context('USERENV','SESSION_SCHEMA') then 1
                 when c.owner = 'SYS' then 2 else 3 end, c.owner) rn
  from all_tab_columns c
  where c.table_name in ( upper('$vtab'),
        replace(upper('$vtab'),'GV\$','GV_\$'),
        replace(upper('$vtab'),'V\$','V_\$') )
  group by c.owner, c.table_name
) where rn = 1;
exit")
  # 2) 兜底: 同义词解析 (gv$/v$/dba_ 系列)
  if [ -z "$res" ] || echo "$res" | grep -q 'ORA-'; then
    res=$(qsql "set heading off feedback off pages 0 verify off define off
select nm from (
  select s.table_owner||'.'||s.table_name nm,
         row_number() over (order by case when s.owner='PUBLIC' then 0 else 1 end) rn
  from all_synonyms s
  where s.synonym_name = upper('$vtab')
) where rn = 1;
exit")
  fi
  echo "$res" | grep -q 'ORA-' && return 1
  LK_FULL=$(echo "$res" | head -1 | tr -d ' ')
  [ -z "$LK_FULL" ] && return 1
  LK_COLS=$(qsql "set heading off feedback off pages 0 verify off define off
select column_name from all_tab_columns
where owner||'.'||table_name = '$LK_FULL'
order by column_id;
exit")
  echo "$LK_COLS" | grep -q 'ORA-' && return 1
  LK_COLS=$(echo "$LK_COLS" | grep -v '^[[:space:]]*$' | tr '\n' ' ' | sed 's/  */ /g')
  return 0
}

resolve_view() {
  local v="$1" chk
  case "$v" in
    "")          v="dba_hist_active_sess_history" ;;
    gv|gash)     v="gv\$active_session_history" ;;
    v|ash)       v="v\$active_session_history" ;;
    hist|h|awr)  v="dba_hist_active_sess_history" ;;
  esac
  valid_qual "$v" || die "非法视图/表名: $v (含 \$ 请加引号或用 gv/v 简写)"
  lookup_table "$v" || die "找不到 [$v]: 检查名字/属主/权限 (需要 SELECT DICTIONARY)"
  RV_FULL="$LK_FULL"
  COLS="$LK_COLS"

  for c in SAMPLE_TIME SESSION_ID SESSION_SERIAL# EVENT SESSION_STATE SQL_ID PROGRAM MACHINE; do
    has_col "$c" || die "[$v] 缺少必需列 $c -- 不是可分析的 ASH 结构数据源"
  done

  if has_col INST_ID; then
    RV_KIND=gv;     ICOL="inst_id";         ICOLN="inst_id";         IV=1
  elif has_col SNAP_ID; then
    has_col INSTANCE_NUMBER || die "[$v] 有 SNAP_ID 但无 INSTANCE_NUMBER"
    RV_KIND=hist;   ICOL="instance_number"; ICOLN="instance_number"; IV=10
  elif has_col INSTANCE_NUMBER && has_col DBID; then
    # 常见 CTAS 导入形态: 从 dba_hist_ash 导入 (去掉 snap_id 但保留 instance_number/dbid)
    RV_KIND=hist;   ICOL="instance_number"; ICOLN="instance_number"; IV=10
  elif has_col INSTANCE_NUMBER; then
    # 有实例列但无 snap_id/dbid: 无法确定采样间隔, 默认 hist(10s) 并提示
    RV_KIND=hist;   ICOL="instance_number"; ICOLN="instance_number"; IV=10
    echo "-- 提示: 检测到 INSTANCE_NUMBER 但无 SNAP_ID/DBID, 按 hist(10s) 处理;"
    echo "--        若源是 1s 采样表, -w 容差和 est_sec 请按 1s 口径解读."
  else
    RV_KIND=single; ICOL="1";               ICOLN="1";               IV=1
  fi

  if has_col SAMPLE_ID; then
    SMATCH="sample_id"; SMATCH_T="to_char(sample_id)"
    CRM="connect_by_root(sample_id)"
  else
    SMATCH="to_char(sample_time,'YYYY-MM-DD HH24:MI:SS.FF3')"
    SMATCH_T="$SMATCH"
    CRM="connect_by_root(sample_time)"
  fi

  if [ "$RV_KIND" = "single" ]; then CRINST="1"; else CRINST="connect_by_root($ICOLN)"; fi

  if has_col BLOCKING_SESSION_SERIAL#; then
    CBSER="prior blocking_session_serial# = session_serial#"
  else
    CBSER=""
  fi

  if [ -z "$XTOL" ]; then
    if [ "$RV_KIND" = "hist" ]; then XTOL=5; else XTOL=2; fi
  fi

  [ -n "$DBIDF" ] && { has_col DBID   || die "[-D] 该数据源无 DBID 列"; }
  [ -n "$CONF"  ] && { has_col CON_ID || die "[-C] 该数据源无 CON_ID 列"; }

  chk=$(qsql "set heading off feedback off pages 0
select 'OK' from $RV_FULL where rownum <= 1;
exit")
  echo "$chk" | grep -q 'ORA-' && die "无法查询 $RV_FULL: $chk"
}
if [ "$CMD" = "export" ] || [ "$CMD" = "diag" ]; then
  vmsg "export/diag 模式: 跳过数据源解析与映射表校验 (不连库)"
