banner() {
  echo "==================================================================="
  echo " ash_analyzer v$VERSION | 命令: $CMD"
  echo " 连接   : SID=${ORACLE_SID:-(remote)}${PDB:+ PDB=$PDB}  数据源: $RV_FULL"
  echo " 布局   : $RV_KIND [间隔=${IV}s 实例列=$INSTDSP]"
  echo " 窗口   : $TW_DESC"
  echo " 实例   : ${INSTF:-全部}  TopN: $TOPN  跨实例容差: ${XTOL}s"
  echo "==================================================================="
}
hdr() { echo; echo "=== $* ==="; }

run_sql() {
  if [ "$VERBOSE" = "1" ]; then
    echo "----- SQL -----" >&2; printf '%s\n' "$1" >&2; echo "----- /SQL -----" >&2
  fi
  {
    echo "set linesize 300 pagesize 1000 trimspool on verify off feedback off echo off define off"
    echo "alter session set nls_date_format='YYYY-MM-DD HH24:MI:SS';"
    echo "alter session set nls_timestamp_format='YYYY-MM-DD HH24:MI:SS.FF3';"
    if [ -n "$PDB" ]; then echo "alter session set container=\"$PDB\";"; fi
    [ -n "$PSES" ] && printf '%s\n' "$PSES"
    printf '%s\n' "$1"
    echo "exit"
  } | "$SQLBIN" -S -L "$CONN"
}

