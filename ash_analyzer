    echo "   obj      ... -objmap  <导入的 dba_objects 表>"
    echo "   text     ... -sqlmap  <导入的 sqltext 表>"
    echo "   sessions ... -usermap <导入的 users 表>"
  fi

  if has_col CON_ID; then
    hdr "CON_ID 分布 (-C 可锁定; 1=CDB根 2=SEED >2=PDB)"
    run_sql "select con_id, count(*) rows_ from $RV_FULL group by con_id order by 1;"
  fi

  hdr "活跃密度: 最密集的 24 个小时"
  run_sql "col hh format a16
select * from (
select to_char(trunc(sample_time,'hh'),'YYYY-MM-DD HH24') hh, count(*) rows_per_hour
from $RV_FULL
group by trunc(sample_time,'hh')
order by rows_per_hour desc
) where rownum <= 24;"

  hdr "采样断档 (> $((IV * 3))s, 按实例)"
  run_sql "col inst format 9999 heading 'INST'
col gap_s format 999999 heading 'GAP_S'
select * from (
select $ICOL inst, to_char(prev_t,'YYYY-MM-DD HH24:MI:SS') gap_from,
to_char(cur_t,'YYYY-MM-DD HH24:MI:SS') gap_to, gap_s
from (
  select $ICOLN, prev_t, cur_t,
         round((cast(cur_t as date) - cast(prev_t as date)) * 86400) gap_s
  from (
    select $ICOLN, lag(sample_time) over (partition by $ICOLN order by sample_time) prev_t,
           sample_time cur_t
    from (select distinct $ICOLN, sample_time from $RV_FULL)
  )
)
where gap_s > $((IV * 3)) and gap_s < 86400
order by 1, 2
) where rownum <= 200;"

  echo
  echo "-- 断档 = 实例宕机 / ASH 缓冲被冲刷 / 数据被清理; 下钻前先钉住窗口."
}

