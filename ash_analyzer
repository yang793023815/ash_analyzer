fi
if [ -n "$ORACLE_SID" ] && [ -z "$ORACLE_HOME" ]; then
  export ORACLE_HOME=$(awk -F: -v s="$ORACLE_SID" '$1==s {print $2; exit}' /etc/oratab 2>/dev/null)
  if [ -z "$ORACLE_HOME" ]; then
    for hh in $(awk -F: '/^[^#+-]/ && $2!="" {print $2}' /etc/oratab 2>/dev/null | sort -u) \
              /opt/oracle/product/*/dbhome_* /u01/app/oracle/product/*/dbhome_* \
              /opt/oracle/products/*/dbhome_* /opt/ora*/*/dbhome_*; do
      [ -x "$hh/bin/sqlplus" ] || continue
      _tst=$(ORACLE_HOME="$hh" ORACLE_SID="$ORACLE_SID" PATH="$hh/bin:/usr/bin:/bin" \
             timeout 20 "$hh/bin/sqlplus" -S -L '/ as sysdba' <<'TE' 2>/dev/null
set heading off feedback off pages 0
select 'ASH_HOME_OK' from dual;
exit
TE
)
      case "$_tst" in *ASH_HOME_OK*) export ORACLE_HOME="$hh"; break ;; esac
    done
  fi
fi
[ -z "$ORACLE_HOME" ] && { say "!! 无法确定 ORACLE_HOME: 请先 . oraenv"; exit 1; }
[ -z "$ORACLE_SID"  ] && { say "!! 无法确定 ORACLE_SID : 请先 . oraenv";  exit 1; }
export PATH="$ORACLE_HOME/bin:$PATH"
CONN="/ as sysdba"

_DBOK=$(sqlplus -S -L "$CONN" <<'DBIDQ'
set pages 0 lines 120 heading off feedback off
select 'CONNECTED_DB: '||name||'  dbid='||dbid from v$database;
exit
DBIDQ
)
