    echo "-- 无 BLOCKING_SESSION 列, 跳过"
  fi

  echo
  echo "############ 方法提示 ############"
  echo "-- 1) 峰值突增段 => 锁定问题窗口 (trend)"
  echo "-- 2) 顶级事件 => 症状分类: CPU/IO/锁/集群 (events)"
  echo "-- 3) root blocker 的 root_evt => 真正病灶 (blockers)"
  echo "-- 4) chain -S <root_sid> 看链路; detail -S 看 seq# 停滞"
  echo "-- 5) obj 热点对象; res 内存/临时段; text -q <sql_id> 看 SQL"
  echo "-- 6) est_sec = 样本 x ${IV}s | 布局: $RV_KIND | 容差: ${XTOL}s"
}

#=====================================================================
# export -- 生成客户环境信息收集脚本 (四件套 + expdp)
#=====================================================================
cmd_export() {
  echo "==================================================================="
  echo " ash_analyzer v$VERSION | 生成客户环境 ASH 信息收集脚本"
  echo "==================================================================="
  echo
  echo "-- 用途: 在客户环境收集指定时间窗口的 ASH + 配套字典, 打成 dmp"
  echo "-- 注意: -s 指定的是 ORACLE_SID(目标库); RAC 多实例想限定节点请用 -g <实例号>"
  echo "--       拷回本机 impdp 后用 ash_analyzer -i <导入表> 分析."
  echo
  while : ; do
    if [ -n "$TBEG" ]; then
      printf "窗口起点 -t [%s]: " "$TBEG"
      if ! read -r ans; then ans=""; fi
      [ -n "$ans" ] && { valid_ts "$ans" || { echo "  格式应为 YYYY-MM-DD HH24:MI:SS, 重输" >&2; continue; }; TBEG="$ans"; }
    else
      printf "窗口起点 -t (YYYY-MM-DD HH24:MI:SS): "
      read -r ans || { echo "输入结束(EOF)且未提供 -t" >&2; exit 1; }
      [ -z "$ans" ] && { echo "  不能为空" >&2; continue; }
      valid_ts "$ans" || { echo "  格式应为 YYYY-MM-DD HH24:MI:SS, 重输" >&2; continue; }
      TBEG="$ans"
    fi
    break
  done
  while : ; do
    if [ -n "$TEND" ]; then
      printf "窗口终点 -T [%s]: " "$TEND"
      if ! read -r ans; then ans=""; fi
      [ -n "$ans" ] && { valid_ts "$ans" || { echo "  格式应为 YYYY-MM-DD HH24:MI:SS, 重输" >&2; continue; }; TEND="$ans"; }
    else
      printf "窗口终点 -T (YYYY-MM-DD HH24:MI:SS): "
      read -r ans || { echo "输入结束(EOF)且未提供 -T" >&2; exit 1; }
      [ -z "$ans" ] && { echo "  不能为空" >&2; continue; }
      valid_ts "$ans" || { echo "  格式应为 YYYY-MM-DD HH24:MI:SS, 重输" >&2; continue; }
      TEND="$ans"
    fi
    if [ "$TEND" \< "$TBEG" ]; then echo "  终点必须晚于起点, 重输" >&2; continue; fi
    break
  done

  # 实例说明: -s 选的是 ORACLE_SID(哪个库); RAC 多实例时用 -g N 限定 instance_number
  printf "RAC 实例号过滤 -g (1..N, 回车=全部实例)%s\n" "${INSTF:+ [$INSTF]}"
  if [ -z "$INSTF" ]; then
    read -r ans || ans=""
    case "$ans" in
      "") : ;;
      [1-9]|[1-9][0-9]) INSTF="$ans" ;;
      *) echo "  实例号应为数字, 忽略该输入(=全部实例)" >&2 ;;
    esac
  fi

  local tag
  tag=$(echo "${TBEG} ${TEND}" | tr -dc '0-9' | cut -c1-12)
  [ -z "$tag" ] && tag=$(date +%Y%m%d%H%M%S)
  [ -z "$OUTF" ] && OUTF="/tmp/ash_collect_${tag}.sh"

  local inst_line=""
  [ -n "$INSTF" ] && inst_line="and instance_number = $INSTF"

  cat > "$OUTF" <<'GENEOF'
#!/bin/bash
