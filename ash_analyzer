_t1=$(ask "窗口起点 YYYY-MM-DD HH24:MI:SS (回车=沿用)" "${TBEG:-}"); T1="${_t1:-${TBEG:-}}"
_t2=$(ask "窗口终点 YYYY-MM-DD HH24:MI:SS (回车=沿用)" "${TEND:-}"); T2="${_t2:-${TEND:-}}"
[ -z "$T1" ] && { say "!! 起点为空且无上次值"; exit 1; }
[ -z "$T2" ] && { say "!! 终点为空且无上次值"; exit 1; }
[ "$T2" \< "$T1" ] && { say "!! 终点必须晚于起点"; exit 1; }
printf 'TBEG="%s"\nTEND="%s"\n' "$T1" "$T2" > "$CFG"
TAG=$(echo "$T1 $T2" | tr -dc '0-9')
EXP="diag_report_${TAG}.txt"
echo "窗口 $T1 ~ $T2   报告: $EXP"
echo "-- 收集中 (只读查询)..."

run() {
  sqlplus -S -L "$CONN" <<SQLEOF
set pagesize 0 linesize 220 trimspool on verify off feedback off echo off define off heading on
alter session set nls_date_format='YYYY-MM-DD HH24:MI:SS';
alter session set nls_timestamp_format='YYYY-MM-DD HH24:MI:SS.FF3';
$2
exit
