       dbms_lob.substr(s.sql_text, 3800, 1) sql_text
  from dba_hist_sqltext s
 where s.sql_id in (select distinct sql_id from @@TOWNER@@.m_ash_@@TAG@@ where sql_id is not null)
   and s.dbid = (select dbid from v$database where rownum = 1)
