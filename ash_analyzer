DBID=$(sqlplus -S -L "$ASH_CONN" <<'DBIDQ' 2>/dev/null
set pages 0 lines 120 heading off feedback off
select 'CONNECTED_DB: '||name||' dbid='||dbid||' '||log_mode from v$database;
exit
DBIDQ
)
