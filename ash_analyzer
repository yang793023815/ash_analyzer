#=====================================================================
# blockers
#=====================================================================
cmd_blockers() {
  has_col BLOCKING_SESSION || die "[$RV_FULL] 无 BLOCKING_SESSION 列, 无法分析阻塞"
  banner

  hdr "直接阻塞者 (等待者指向的 SID, 一层)"
  run_sql "col binst format 9999 heading 'BINST'
col bsid format 9999999 heading 'BSID'
col bstat format a9 heading 'STATUS'
col wait_evt format a36 heading 'WAIT_EVT'
select * from (
select $(numcol BLOCKING_INST_ID) binst, blocking_session bsid,
$(strcol BLOCKING_SESSION_STATUS) bstat,
nvl(event,'ON CPU') wait_evt,
count(*) blocked_samples, round(count(*)*$IV) est_sec,
count(distinct session_id) blocked_sess
from $RV_FULL
where $TW and blocking_session is not null
group by $(numcol BLOCKING_INST_ID), blocking_session,
$(strcol BLOCKING_SESSION_STATUS), nvl(event,'ON CPU')
order by blocked_samples desc
) where rownum <= $TOPN;"
  echo
  echo "-- STATUS=VALID 但上面表里找不到该 SID 行 => 持有者空闲未被采样(常见)."

  hdr "根阻塞者 Root Blocker (等待树终点 = 终极持有者)"
  build_cb
  run_sql "col root_inst format 9999 heading 'R_INST'
col root_sid format 9999999 heading 'R_SID'
col root_ser format 9999999 heading 'R_SER'
col root_prog format a26
col root_evt format a45
col root_sql format a15
select * from (
select ri root_inst, sid root_sid, ser root_ser,
max(prog) root_prog, max(sqlid) root_sql, evt root_evt,
count(*) chains, count(distinct sw) waiters, count(distinct st) root_samples,
to_char(min(ts),'MM-DD HH24:MI:SS') first_t,
to_char(max(ts),'MM-DD HH24:MI:SS') last_t
from (
  select ri, sid, ser, prog, sqlid, evt, ts, st,
         to_char(sti)||'.'||to_char(ssid) sw
  from (
    select connect_by_isleaf isl,
           $ICOL ri, session_id sid, session_serial# ser,
           program prog, sql_id sqlid, nvl(event,'ON CPU') evt,
           sample_time ts, $SMATCH_T st,
           $CRINST sti, connect_by_root(session_id) ssid
    from (select /*+ materialize$PHINT */ * from $RV_FULL where $TW) ash_win
    start with blocking_session is not null
    connect by nocycle
          $CB
  )
  where isl = 1
)
group by ri, sid, ser, evt
having count(*) >= 2
order by chains desc
) where rownum <= $TOPN;"
  echo
  echo "-- 判读: root_evt 是终极持有者自己在等的事件 => 真正病灶通常在这里,"
  echo "--   而不是等待者表面的 event (如 cursor: pin S 的根常是 SGA resize)."
  echo "-- chains=终点落在该持有者的链条数(样本级); waiters=不同受害者会话数;"
  echo "-- root_samples=持有者作为链终点的样本数(持续时长参考); first/last=时间范围."
  echo "-- 跨实例边按 ${XTOL}s 容差匹配; 未被采样的持有者不进树 -> 对照上面直接表."
  echo "-- 大窗口慢时: 缩窗口或 -p N 并行."
}

#=====================================================================
# chain
#=====================================================================
cmd_chain() {
  has_col BLOCKING_SESSION || die "[$RV_FULL] 无 BLOCKING_SESSION 列, 无法分析等待链"
  banner
  build_cb

  if [ -n "$SESSID" ]; then
    hdr "会话 $SESSID 向上等待链 (path: 受害者>...>终点; 每行一个采样)"
    run_sql "col ts format a21
col path format a60
col event format a32
col sql_id format a15
col program format a26
col binst format 9999 heading 'BINST'
col bsid format 9999999 heading 'BSID'
select * from (
select ts, path, lv, isleaf, iscycle, inst, sid, ser, state, event,
sql_id, program, binst, bsid
from (
select level lv, connect_by_isleaf isleaf, connect_by_iscycle iscycle,
to_char(sample_time,'YYYY-MM-DD HH24:MI:SS') ts, $ICOL inst,
session_id sid, session_serial# ser, session_state state,
nvl(event,'ON CPU') event, sql_id sql_id, program program,
rpad(substr(sys_connect_by_path($PELEM, '>'), 2),60) path,
$(strcol BLOCKING_INST_ID) binst, $(strcol BLOCKING_SESSION) bsid,
$CRM rsmt, $CRINST rinst, connect_by_root(session_id) rsid
from (select /*+ materialize$PHINT */ * from $RV_FULL where $TW) ash_win
start with session_id = $SESSID
connect by nocycle
      $CB
)
order by rsmt, rinst, rsid, lv
) where rownum <= 5000;"
    echo
    echo "-- path 最左 = 追踪的会话, 向右依次是它等的人; isleaf=1 = 链终点"
    echo "--   (持有者未被采样或真无阻塞). iscycle=1 = 等待环(重点!)."
    echo "-- path 缩写: 元素=sid; 跨实例链元素带实例号(实例.sid). 列宽 60."
    echo "-- 窗口内无该会话样本时输出为空: 调整 -m/-t/-T."
  else
    hdr "等待链树 (path: 受害者>...>终点; 仅显示 >=2 层的链)"
    run_sql "col ts format a21
col path format a60
col event format a32
col sql_id format a15
col program format a26
col binst format 9999 heading 'BINST'
col bsid format 9999999 heading 'BSID'
select * from (
select ts, path, lv, isleaf, iscycle, inst, sid, ser, state, event,
sql_id, program, binst, bsid
from (
select x.*, max(lv) over (partition by rinst, rsid, rsmt) maxlv
from (
select level lv, connect_by_isleaf isleaf, connect_by_iscycle iscycle,
to_char(sample_time,'YYYY-MM-DD HH24:MI:SS') ts, $ICOL inst,
session_id sid, session_serial# ser, session_state state,
nvl(event,'ON CPU') event, sql_id sql_id, program program,
rpad(substr(sys_connect_by_path($PELEM, '>'), 2),60) path,
$(strcol BLOCKING_INST_ID) binst, $(strcol BLOCKING_SESSION) bsid,
$CRM rsmt, $CRINST rinst, connect_by_root(session_id) rsid
from (select /*+ materialize$PHINT */ * from $RV_FULL where $TW) ash_win
start with blocking_session is not null
connect by nocycle
      $CB
) x
)
where maxlv >= 2
order by rsmt, rinst, rsid, lv
) where rownum <= 2000;"
    echo
    echo "-- 每行 path 是完整链: 最左=受害者, 最右=链终点(持有者); 输出截断 2000 行."
    echo "-- path 缩写: 元素=sid; 跨实例链元素带实例号(实例.sid). 列宽 60."
    echo "-- 单层链(持有者未被采样)看 blockers; iscycle=1 = 等待环(死锁类, 重点!)."
    echo "-- 建议小窗口 (默认5分钟); 跨实例边按 ${XTOL}s 容差匹配."
  fi
}

#=====================================================================
# detail
#=====================================================================
cmd_detail() {
  banner
  hdr "会话 $SESSID ASH 时间线"
  run_sql "col ts format a23
col event format a32
col sql_id format a15
col program format a24
col bstat format a9 heading 'BSTAT'
col p1t format a17
col p2t format a17
select to_char(sample_time,'YYYY-MM-DD HH24:MI:SS.FF3') ts, $ICOL inst,
session_id sid, session_serial# ser, session_state,
nvl(event,'ON CPU') event, $(numcol SEQ#) seq#,
$(strcol P1TEXT) p1t, $(numcol P1) p1, $(strcol P2TEXT) p2t, $(numcol P2) p2,
sql_id, $(numcol SQL_PLAN_HASH_VALUE) phv, $(numcol SQL_EXEC_ID) exec_id,
$(strcol BLOCKING_INST_ID) binst, $(strcol BLOCKING_SESSION) bsid,
$(strcol BLOCKING_SESSION_STATUS) bstat,
$(numcol PGA_ALLOCATED) pga_b, $(numcol TEMP_SPACE_ALLOCATED) tmp_b,
program
from $RV_FULL
where $TW and session_id = $SESSID
order by sample_time;"

  hdr "seq# 停滞分析 (同 event+seq# 多次采样 = 卡在同一等待)"
  run_sql "col event format a32
col first_t format a20
col last_t format a20
select * from (
select nvl(event,'ON CPU') event, $(numcol SEQ#) seq#, count(*) samples,
count(*)*$IV est_sec,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI:SS') first_t,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI:SS') last_t
from $RV_FULL
where $TW and session_id = $SESSID
group by nvl(event,'ON CPU'), $(numcol SEQ#)
having count(*) > 1
order by samples desc
) where rownum <= $TOPN;"
  echo
  echo "-- seq# 不变 = 卡死在同一等待(hang); seq# 递进 = 在走只是慢."
  echo "-- p1/p2 配合 p1t/p2t: 如 db file sequential read 的 p1=file# p2=block#."
}

