}

IC="__ICOL__"
IL="__INST_LINE__"
{
echo "==================================================================="
echo " ASH 初步诊断报告 | 数据源: $V"
echo " 时间窗口 : $T1 ~ $T2    实例: ${INSTF:-全部}"
echo " 生成时间 : $(date '+%Y-%m-%d %H:%M:%S')    主机: $(hostname)"
echo " 诊断工具 : ash_analyzer diag (六步法自动版)"
echo "==================================================================="

run W0 "select 'ROWS_IN_WINDOW: '||count(*) from (
select *
  from $V
 where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
   and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
   $IL);"

