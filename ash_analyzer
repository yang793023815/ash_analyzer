#---------------------------------------------------------------------
# 环境探测: sqlplus / ORACLE_HOME / ORACLE_SID
#---------------------------------------------------------------------
find_env() {
  local cand sid base h
  sid="$SID_IN"
  [ -z "$sid" ] && [ -n "$ORACLE_SID" ] && sid="$ORACLE_SID"
  if [ -z "$sid" ]; then
    sid=$(ps -ef 2>/dev/null | grep 'ora_pmon_' | grep -v grep | sed 's/.*ora_pmon_//' | grep -v '^[+-]' | grep -E '^[A-Za-z][A-Za-z0-9_$#]*$' | head -1)
  fi
  if [ -z "$sid" ]; then
    sid=$(awk -F: '/^[^#+-]/ && $1!="" {print $1; exit}' /etc/oratab 2>/dev/null)
  fi
  h=""
  if [ -n "$sid" ]; then
    h=$(awk -F: -v s="$sid" '$1==s {print $2; exit}' /etc/oratab 2>/dev/null)
    if [ -z "$h" ]; then
      base=$(echo "$sid" | sed 's/[0-9]*$//')
      [ -n "$base" ] && h=$(awk -F: -v b="$base" '$1==b {print $2; exit}' /etc/oratab 2>/dev/null)
    fi
  fi
  # 兜底: oratab 未登记的实例无法用 /proc 反推 (oracle 进程 dumpable=0),
  # 改用 bequeath 试连: 逐个候选 home 用 / as sysdba 连接, 能查通的那个即实例 home
  if [ -z "$h" ] && [ -n "$sid" ]; then
    HOMES=""
    for hh in $(awk -F: '/^[^#+-]/ && $2!="" {print $2}' /etc/oratab 2>/dev/null | sort -u); do
      [ -x "$hh/bin/sqlplus" ] && HOMES="$HOMES $hh"
    done
    for cand in /opt/oracle/product/*/dbhome_* /u01/app/oracle/product/*/dbhome_* \
                /opt/oracle/products/*/dbhome_* /u01/app/oracle/product/*/*.*.* \
                /opt/ora*/*/dbhome_*; do
      [ -x "$cand/bin/sqlplus" ] || continue
      case " $HOMES " in *" $cand "*) ;; *) HOMES="$HOMES $cand";; esac
    done
    TO=""; command -v timeout >/dev/null 2>&1 && TO="timeout 20"
    for hh in $HOMES; do
      tst=$(ORACLE_HOME="$hh" ORACLE_SID="$sid" PATH="$hh/bin:/usr/bin:/bin" $TO "$hh/bin/sqlplus" -S -L '/ as sysdba' <<'TE' 2>/dev/null
set heading off feedback off pages 0
select 'ASH_HOME_OK' from dual;
exit
TE
)
      case "$tst" in *ASH_HOME_OK*) h="$hh"; vmsg "env: home by bequeath probe -> $h"; break ;; esac
    done
  fi
  # 多实例主机提示 (自动选库时)
  if [ -z "$SID_IN" ] && [ -z "${ORACLE_SID:-}" ]; then
    cands=$(ps -ef 2>/dev/null | grep 'ora_pmon_' | grep -v grep | sed 's/.*ora_pmon_//' | grep -v '^[+-]' | grep -E '^[A-Za-z][A-Za-z0-9_$#]*$' | tr '\n' ' ')
    cn=$(echo $cands | wc -w | tr -d ' ')
    if [ "$cn" -gt 1 ]; then
      echo "-- 注意: 本机有多个实例 [$cands], 自动选用 SID=$sid; 如非目标库请用 -s 指定" >&2
    fi
  fi
  if [ -n "$h" ] && [ -x "$h/bin/sqlplus" ]; then
    export ORACLE_HOME="$h"; export ORACLE_SID="$sid"
    SQLBIN="$h/bin/sqlplus"
    vmsg "env: ORACLE_HOME=$h ORACLE_SID=$sid (oratab)"
    return
  fi
  if [ -n "$ORACLE_HOME" ] && [ -x "$ORACLE_HOME/bin/sqlplus" ]; then
    SQLBIN="$ORACLE_HOME/bin/sqlplus"
    vmsg "env: sqlplus <- ORACLE_HOME"
    return
  fi
  if command -v sqlplus >/dev/null 2>&1; then
    SQLBIN=$(command -v sqlplus)
    vmsg "env: sqlplus <- PATH"
    return
  fi
  for cand in /opt/oracle/product/*/dbhome_* /u01/app/oracle/product/*/dbhome_* \
              /opt/oracle/products/*/dbhome_* /u01/app/oracle/product/*/*.*.* \
              /opt/ora*/*/dbhome_*; do
    if [ -x "$cand/bin/sqlplus" ]; then
      export ORACLE_HOME="$cand"
      [ -n "$sid" ] && export ORACLE_SID="$sid"
      SQLBIN="$cand/bin/sqlplus"
      vmsg "env: sqlplus <- 扫描 $cand"
      return
    fi
  done
  if [ "$CMD" = "export" ] || [ "$CMD" = "diag" ]; then
    vmsg "env: export/diag 模式跳过 sqlplus 探测 (仅生成脚本)"
    return 0
  fi
  die "找不到 sqlplus; 请设置 ORACLE_HOME 或用 -s SID"
}

