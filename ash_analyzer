from $RV_FULL where $TW group by $ICOLN order by 1;"

  echo
  echo "############ 2. 峰值样本 ############"
  local ss="" sg=""
  if has_col SAMPLE_ID; then ss="sample_id,"; sg="sample_id,"; fi
  run_sql "col ts format a22
select * from (
select $ICOL inst, $ss to_char(sample_time,'YYYY-MM-DD HH24:MI:SS') ts, count(*) active_sess
from $RV_FULL where $TW
group by $ICOLN, $sg to_char(sample_time,'YYYY-MM-DD HH24:MI:SS')
order by active_sess desc
) where rownum <= $TOPN;"

  echo
  echo "############ 3. 顶级事件 ############"
  run_sql "col event format a46
col wait_class format a14
select * from (
select nvl(event,'ON CPU') event, nvl($(strcol WAIT_CLASS),'-') wait_class,
count(*) samples, round(count(*)*$IV) est_sec, count(distinct sql_id) sql_cnt
from $RV_FULL where $TW
group by nvl(event,'ON CPU'), nvl($(strcol WAIT_CLASS),'-')
order by samples desc
) where rownum <= $TOPN;"

  echo
  echo "############ 4. SQL 排行 ############"
  run_sql "col sql_id format a15
col opname format a14
select * from (
select sql_id, max($(strcol SQL_OPNAME)) opname, count(*) samples, round(count(*)*$IV) est_sec,
count(distinct session_id) sess_cnt
from $RV_FULL where $TW and sql_id is not null
group by sql_id order by samples desc
) where rownum <= $TOPN;"

  echo
  echo "############ 5. 会话排行 ############"
  if has_col USER_ID; then
    run_sql "col program format a30
col username format a12
select * from (
select $ICOL inst, a.session_id, a.session_serial#, max(u.username) username,
max(a.program) program, count(*) samples, round(count(*)*$IV) est_sec
from $RV_FULL a, $UTBL u
where $TW and a.user_id = u.user_id (+)
group by $ICOLN, a.session_id, a.session_serial#
order by samples desc
) where rownum <= $TOPN;"
  fi

  echo
  echo "############ 6. 阻塞 ############"
  if has_col BLOCKING_SESSION; then
    run_sql "col binst format 9999 heading 'BINST'
col bsid format 9999999 heading 'BSID'
col bstat format a9 heading 'STATUS'
