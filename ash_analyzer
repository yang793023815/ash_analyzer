run W2 "col event format a46 heading EVENT
col wait_class format a14
select * from (
select nvl(event,'ON CPU') event, nvl(wait_class,'-') wait_class,
count(*) samples, count(*)*10 est_sec
from $V
where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
  and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
  $IL
group by nvl(event,'ON CPU'), nvl(wait_class,'-')
order by samples desc) where rownum <= 15;"

echo
