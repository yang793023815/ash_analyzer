run W3 "col sql_id format a15
col opname format a14
select * from (
select sql_id, max(sql_opname) opname, count(*) samples
from $V
where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
  and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
  and sql_id is not null
group by sql_id order by samples desc) where rownum <= 15;"

echo
echo "########## 4. 直接阻塞者 ##########"
run W4 "col binst heading BINST for 9999
col bsid heading BSID for 9999999
col bstat heading STATUS for a9
select * from (
select blocking_inst_id binst, blocking_session bsid,
blocking_session_status bstat, nvl(event,'ON CPU') wait_evt,
count(*) blocked_samples, count(distinct session_id) blocked_sess
from $V
where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
  and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
  and blocking_session is not null
group by blocking_inst_id, blocking_session, blocking_session_status, nvl(event,'ON CPU')
order by blocked_samples desc) where rownum <= 12;"

echo
echo "########## 5. 根阻塞者 (等待树终点) ##########"
run W5 "col root_inst heading R_INST for 9999
col root_sid heading R_SID for 9999999
col root_evt format a34
select * from (
select ri root_inst, sid root_sid, max(prog) root_prog, evt root_evt,
count(*) chains, count(distinct sw) waiters
from (
  select connect_by_isleaf isl, $IC ri, session_id sid,
         program prog, nvl(event,'ON CPU') evt,
         to_char(connect_by_root($IC))||'.'||to_char(connect_by_root(session_id)) sw
  from (
    select /*+ materialize */ *
    from $V
    where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
      and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
      $IL
  ) ash
   start with blocking_session is not null
  connect by nocycle
        prior blocking_session = session_id
        and nvl(nullif(prior blocking_inst_id,0), prior $IC) = $IC
        and (( prior $IC = $IC
               and prior to_char(sample_time,'YYYY-MM-DD HH24:MI:SS.FF3') = to_char(sample_time,'YYYY-MM-DD HH24:MI:SS.FF3') )
             or ( prior $IC <> $IC
                  and abs((cast(prior sample_time as date) - cast(sample_time as date))*86400) <= 5 ))
) where isl = 1
group by ri, sid, evt having count(*) >= 2
order by chains desc) where rownum <= 12;"

echo
echo "########## 6. 热点对象 (Top10) ##########"
run W6 "col objname format a44
select * from (
select a.current_obj# obj#,
nvl(o.owner||'.'||o.object_name,'(未解析)') objname,
nvl(a.event,'ON CPU') event, count(*) samples
from $V a, __OBJTBL__ o
where a.current_obj# > 0 and a.current_obj# = o.object_id (+)
group by a.current_obj#, nvl(o.owner||'.'||o.object_name,'(未解析)'), nvl(a.event,'ON CPU')
order by samples desc) where rownum <= 10;"
} > "$EXP" 2>&1

# ---- 规则化初步结论 (追加到报告) ----
{
echo
echo "########## 8. 初步结论 (规则自动生成) ##########"
NROW=$(grep -m1 ROWS_IN_WINDOW "$EXP" | grep -o '[0-9]*$')
if [ -z "$NROW" ] || [ "$NROW" -eq 0 ]; then
  echo "!! 窗口内无样本: 检查数据源/时间窗/AWR flush"
else
  TOP=$(awk '/顶级等待事件 \(症状定性\)/{f=1;next} /SQL 排行/{f=0} f && $0 !~ /^(=|[[:space:]]*$|----|########)/ {n=$(NF-1); $NF=""; $(NF-1)=""; e=$0; sub(/[[:space:]]+$/, "", e); gsub(/[[:space:]]+/, " ", e); if (e != "" && n ~ /^[0-9]+$/) print e "\t" n}' "$EXP" | head -3)
  echo "样本量: $NROW"
  echo "Top3 事件指向:"
  while IFS=$'\t' read -r ev n; do
    ev="${ev//$'\t'/ }"
    [ -z "$ev" ] && continue
    if   [[ "$ev" == *HW* ]]; then say "  $ev ($n 样本) -> 段高水位(HWM)推进争用: 大批量插入/LOB; 结合热点对象节"
    elif [[ "$ev" == *TX* ]]; then say "  $ev ($n 样本) -> 行锁争用: 应用事务/并发更新; 结合阻塞者节"
    elif [[ "$ev" == gc* ]]; then say "  $ev ($n 样本) -> RAC 集群块争用: 多为本地慢传导, 看根阻塞者节 root_evt"
    elif [[ "$ev" == *latch* || "$ev" == *mutex* || "$ev" == *pin* ]]; then say "  $ev ($n 样本) -> 内存结构争用: 查硬解析/SGA"
    elif [[ "$ev" == *'log file'* ]]; then say "  $ev ($n 样本) -> redo 瓶颈: LGWR I/O / 归档"
    elif [[ "$ev" == *'db file'* || "$ev" == cell* ]]; then say "  $ev ($n 样本) -> 数据文件 I/O 慢"
    elif [[ "$ev" == ON*CPU* ]]; then say "  ON CPU ($n 样本) -> CPU 密集: 结合 OS runqueue"
    else say "  $ev ($n 样本) -> 见 Oracle 手册"
    fi
  done <<< "$TOP"
  echo
  echo "根阻塞者节为空: 持有者未被 ASH 采样(空闲), 以直接阻塞者节为准."
fi
} >> "$EXP" 2>/dev/null

chmod 644 "$EXP" 2>/dev/null
echo "完成: $EXP"
echo "---- 结论摘要 ----"
sed -n '/8\. 初步结论/,$p' "$EXP" | head -12
GENEOF
  # 占位符替换 (__ASH_VIEW__/__ICOL__/__INST_LINE__/__OBJTBL__ 由生成器填入;
  # 用 sed 而非 heredoc 展开, 避免生成期吃掉运行期变量)
  sed -i.bak "s|__ASH_VIEW__|$ash_src|; s|__ICOL__|$inst_col|; s|__INST_LINE__|$inst_line|; s|__OBJTBL__|${objtbl:-all_objects}|" "$OUTF" && rm -f "$OUTF.bak"
  chmod 700 "$OUTF" 2>/dev/null

  echo
  echo "-- 自诊断脚本已生成: $OUTF (可重复执行; 数据源/时间窗每次输入, 回车沿用)"
  bash -n "$OUTF" || die "生成的脚本语法检查失败"
  echo "-- 语法校验: OK"
  echo "-- 下一步: 发给客户执行 sh $(basename "$OUTF")"
}

