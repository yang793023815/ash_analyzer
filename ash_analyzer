#---------------------------------------------------------------------
# 时间窗口
#---------------------------------------------------------------------
build_tw() {
  TW=""
  if [ -n "$MINS" ]; then
    TW="sample_time >= systimestamp - numtodsinterval($MINS,'minute')"
    TW_DESC="最近 $MINS 分钟"
  elif [ -n "$TBEG" ]; then
    TW="sample_time >= to_timestamp('$TBEG','YYYY-MM-DD HH24:MI:SS')"
    TW_DESC="$TBEG"
    if [ -n "$TEND" ]; then
      TW="$TW and sample_time <= to_timestamp('$TEND','YYYY-MM-DD HH24:MI:SS')"
      TW_DESC="$TBEG ~ $TEND"
    fi
  else
    MINS=60
    TW="sample_time >= systimestamp - numtodsinterval(60,'minute')"
    TW_DESC="最近 60 分钟 (默认; -m/-t/-T 调整)"
  fi
  [ -n "$INSTF" ] && TW="$TW and $ICOL = $INSTF"
  [ -n "$DBIDF" ] && TW="$TW and dbid = $DBIDF"
  [ -n "$CONF"  ] && TW="$TW and con_id = $CONF"
}

#---------------------------------------------------------------------
# connect by 条件 (向上: 子行 = 父行的持有者)
#   同实例: 样本精确匹配
#   跨实例: blocking_inst_id 指向 + 时间容差 (相位差实测标定)
#---------------------------------------------------------------------
build_cb() {
  local c1="prior blocking_session = session_id"
  [ -n "$CBSER" ] && c1="$c1
        and $CBSER"
  # 同实例边要求持有者实例 = 等待者实例, 排除跨实例误配;
  # BLOCKING_SESSION_STATUS=INVALID(会话已消失) 的历史行不可作为链边
  local cself="prior $ICOLN = $ICOLN"
  local bstat=""
  has_col BLOCKING_SESSION_STATUS && bstat=" and nvl(prior blocking_session_status,'VALID') <> 'INVALID'"
  if [ "$RV_KIND" != "single" ] && has_col BLOCKING_INST_ID; then
    CB="$c1$bstat
        and nvl(nullif(prior blocking_inst_id,0), prior $ICOLN) = $ICOLN
        and (
              ( $cself
                and prior $SMATCH = $SMATCH )
              or
              ( prior $ICOLN <> $ICOLN
                and abs((cast(prior sample_time as date) - cast(sample_time as date)) * 86400) <= $XTOL )
            )"
  else
    if [ "$RV_KIND" = "single" ]; then
      CB="$c1$bstat
        and prior $SMATCH = $SMATCH"
    else
      CB="$c1$bstat
        and $cself
        and prior $SMATCH = $SMATCH"
      echo "-- 注意: 数据源无 BLOCKING_INST_ID 列, 跨实例等待链不可用(仅同实例匹配)"
    fi
  fi
  has_col DBID && CB="$CB
        and prior dbid = dbid"
}

