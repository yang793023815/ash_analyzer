  banner
  echo
  echo "############ 1. 范围 ############"
  run_sql "select count(*) rows_in_window,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI:SS') window_begin,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI:SS') window_end
from $RV_FULL where $TW;"
  run_sql "col inst format 9999 heading 'INST'
