  from dba_hist_snapshot
 where end_interval_time >= to_timestamp('@@TBEG@@','YYYY-MM-DD HH24:MI:SS') - 1/24
   and begin_interval_time <= to_timestamp('@@TEND@@','YYYY-MM-DD HH24:MI:SS') + 1/24;
prompt CTAS_DONE
exit
SQLCTAS
if [ $? -ne 0 ]; then log "!! CTAS 失败, 详见 $LOG"; exit 1; fi

log "===== 2. 行数统计 ====="
sqlplus -S -L "$ASH_CONN" <<'SQLCNT' > "$OUT_DIR/counts.txt"
set pages 0 lines 200 heading off feedback off trimspool on
select 'm_ash    : '||count(*) from @@TOWNER@@.m_ash_@@TAG@@;
select 'm_sqltext: '||count(*) from @@TOWNER@@.m_sqltext_@@TAG@@;
select 'm_obj    : '||count(*) from @@TOWNER@@.m_obj_@@TAG@@;
select 'm_users  : '||count(*) from @@TOWNER@@.m_users_@@TAG@@;
select 'm_snap   : '||count(*) from @@TOWNER@@.m_snap_@@TAG@@;
exit
SQLCNT
CNT_OUT=$?
cat "$OUT_DIR/counts.txt" >> "$LOG"

grep -E "m_ash|m_sqltext|m_obj|m_users|m_snap" "$OUT_DIR/counts.txt" | tee -a "$LOG" | head -5

log "===== 3. expdp 打包 ====="
TBLLIST="$TOWNER.m_ash_$TAG,$TOWNER.m_obj_$TAG,$TOWNER.m_sqltext_$TAG,$TOWNER.m_users_$TAG,$TOWNER.m_snap_$TAG"
printf 'userid="%s"\ntables=%s\ndirectory=%s\ndumpfile=ash_collect_%s.dmp\nlogfile=ash_collect_%s_exp.log\ncompression=all\nREUSE_DUMPFILES=y\n' "$ASH_CONN" "$TBLLIST" "$DPDIR" "$TAG" "$TAG" > "$OUT_DIR/exp.par"
sqlplus -S -L "$ASH_CONN" <<'SQLDP' > "$OUT_DIR/dp.txt" 2>/dev/null
set pages 0 lines 300 heading off feedback off trimspool on
select 'DPFOUND: '||directory_path from dba_directories where directory_name=upper('@@DPDIR@@');
exit
SQLDP
DP=$(grep -o 'DPFOUND: .*' "$OUT_DIR/dp.txt" 2>/dev/null | head -1 | sed 's/^DPFOUND: //')
grep -v DPFOUND "$OUT_DIR/dp.txt" >> "$LOG" 2>/dev/null
expdp parfile="$OUT_DIR/exp.par" < /dev/null >> "$LOG" 2>&1
if [ $? -ne 0 ]; then log "!! expdp 失败, 详见 $LOG"; exit 1; fi

log "===== 4. 清理 CTAS 中间表 ====="
sqlplus -S -L "$ASH_CONN" <<'SQLDROP' >> "$LOG" 2>&1
whenever sqlerror continue
set heading off feedback off pages 0
drop table @@TOWNER@@.m_ash_@@TAG@@ purge;
drop table @@TOWNER@@.m_obj_@@TAG@@ purge;
drop table @@TOWNER@@.m_sqltext_@@TAG@@ purge;
drop table @@TOWNER@@.m_users_@@TAG@@ purge;
drop table @@TOWNER@@.m_snap_@@TAG@@ purge;
exit
SQLDROP

DP=$(grep -o 'DPFOUND: .*' "$OUT_DIR/dp.txt" 2>/dev/null | head -1 | sed 's/^DPFOUND: //')
log "============================================================"
log " 收集完成. 产物:"
log "   $DP/ash_collect_$TAG.dmp"
log "   $LOG"
log " 拷回分析机后:"
log "   impdp \"/ as sysdba\" dumpfile=ash_collect_$TAG.dmp"
log "   ./ash_analyzer info -i $TOWNER.m_ash_$TAG"
log "============================================================"
GENEOF
  # 占位符回填 (生成器常量): 窗口/tag/连接/SID/实例过滤
  _DROPS="whenever sqlerror continue"
  for _t in m_ash m_obj m_sqltext m_users m_snap; do
    _DROPS="$_DROPS
drop table system.${_t}_${tag} purge;"
  done
  _SIDLINE='[ -n "'"$SID_IN"'" ]'
  sed -i.bak \
    -e "s|@@TAG@@|$tag|g" \
    -e "s|@@TBEG@@|$TBEG|g" \
    -e "s|@@TEND@@|$TEND|g" \
    -e "s|@@INST_LINE@@|$inst_line|g" \
    -e "s|@@SIDLINE@@|[ -n \"$SID_IN\" ] \&\& { export ORACLE_SID=\"$SID_IN\"; export ORACLE_HOME; }|" \
    -e "s|@@CONNLINE@@|ASH_CONN=\"$CONN\"; export ASH_CONN|" \
    -e "s|@@TOWNER@@|${TOWNER:-system}|g" \
    -e "s|@@DPDIR@@|${DPDIR:-DATA_PUMP_DIR}|g" \
    "$OUTF" >/dev/null 2>&1 || true
  # DROPS 多行替换用 perl 不可靠; 简化: 连同幂等 drop 一起确保 — 直接用 awk 替换含 @@DROPS@@ 行
  _tom="${TOWNER:-system}"
  awk -v tag="$tag" -v tom="$_tom" 'BEGIN{RS="\0"} {gsub(/@@DROPS@@/, "whenever sqlerror continue\ndrop table " tom ".m_ash_" tag " purge;\ndrop table " tom ".m_obj_" tag " purge;\ndrop table " tom ".m_sqltext_" tag " purge;\ndrop table " tom ".m_users_" tag " purge;\ndrop table " tom ".m_snap_" tag " purge;"); print}' "$OUTF" > "$OUTF.new" 2>/dev/null && mv "$OUTF.new" "$OUTF"
  rm -f "$OUTF.bak" 2>/dev/null
  chmod 700 "$OUTF" 2>/dev/null

  echo
  echo "-- 收集脚本已生成: $OUTF"
  echo "-- 窗口: $TBEG ~ $TEND  实例: ${INSTF:-全部}  目标库SID: ${SID_IN:-(运行时自动探测)}"
  echo "-- 临时表用户: ${TOWNER:-system}   导出 directory: ${DPDIR:-DATA_PUMP_DIR}"
  bash -n "$OUTF" || die "生成的脚本语法检查失败"
