  banner
  hdr "数据源对象"
  run_sql "col owner format a14
col object_name format a40
col object_type format a14
select owner, object_name, object_type from all_objects
where owner||'.'||object_name = '$RV_FULL' and rownum = 1;"

  echo " 布局     : $RV_KIND  (实例列: $INSTDSP, 采样间隔: ${IV}s)"
  echo " 列数     : $(echo $COLS | wc -w | tr -d ' ')"

  hdr "总行数 / 时间范围 (全表)"
  run_sql "select count(*) total_rows,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI:SS') earliest,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI:SS') latest
from $RV_FULL;"

  hdr "各实例分布"
  run_sql "col inst format 9999 heading 'INST'
select $ICOL inst, count(*) rows_,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI') first_sample,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI') last_sample
from $RV_FULL
group by $ICOLN
order by 1;"

  if has_col DBID; then
    hdr "DBID 分布 (-D 可锁定)"
    run_sql "select dbid, count(*) rows_,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI') mn,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI') mx
from $RV_FULL group by dbid order by 2 desc;"
