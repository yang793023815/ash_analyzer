  echo "==================================================================="
  echo
  echo "-- 场景: 拿不到 ASH 导出 / 无法远程到客户环境时, 把本脚本发给客户."
  echo "--       客户反复执行: 可随时调整时间窗, 回车沿用上次, 输出简洁."
  echo
  while : ; do
    if [ -n "$VIEW_IN" ]; then
      printf "ASH 视图/表名 -i [%s]: " "$VIEW_IN"
      read -r ans || ans=""
      [ -n "$ans" ] && { valid_qual "$ans" || { echo "  非法对象名, 重输" >&2; continue; }; VIEW_IN="$ans"; }
    else
      printf "ASH 视图/表名 -i (回车=默认 AWR 历史视图): "
      read -r ans || ans=""
      [ -n "$ans" ] && { valid_qual "$ans" || { echo "  非法对象名, 重输" >&2; continue; }; VIEW_IN="$ans"; }
    fi
    break
  done
  [ -z "$VIEW_IN" ] && VIEW_IN="dba_hist_active_sess_history"

  local tag
  tag=$(date +%Y%m%d%H%M%S)
  [ -z "$OUTF" ] && OUTF="/tmp/ash_diag_${tag}.sh"

  local ash_src inst_line inst_col
  case "$VIEW_IN" in
    gv|gash)    ash_src='gv\$active_session_history' ;;
    v|ash)      ash_src='v\$active_session_history' ;;
    hist|h|awr) ash_src='dba_hist_active_sess_history' ;;
    *)          ash_src="$VIEW_IN" ;;
  esac
  [ -n "$INSTF" ] && inst_line="and instance_number = $INSTF"
  case "$ash_src" in *\$|gv*|v*) inst_col="inst_id" ;; *) inst_col="instance_number" ;; esac

  cat > "$OUTF" <<'GENEOF'
#!/bin/bash
#=====================================================================
# ASH 自诊断脚本 (由 ash_analyzer 的 diag 生成; 可重复执行)
# 用法: oracle 用户执行  sh <本脚本>
#   每次运行: 输入数据源/时间窗, 回车沿用上次 (状态存同目录 ash_diag_run.conf)
#   输出简洁: 进度提示 + 结论摘要; 完整报告 diag_report_<tag>.txt 按窗归档
#   只读查询, 不建表不写库; 无 dba 权限自动降级 all_ 视图
