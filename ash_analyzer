echo "########## 1. 实例分布 ##########"
run W1 "set lines 220
col inst heading INST for 9999
col rows_ heading ROWS for 999999
col first_sample format a18
col last_sample format a18
select $IC inst, count(*) rows_,
to_char(min(sample_time),'YYYY-MM-DD HH24:MI:SS') first_sample,
to_char(max(sample_time),'YYYY-MM-DD HH24:MI:SS') last_sample
from $V
where sample_time >= to_timestamp('$T1','YYYY-MM-DD HH24:MI:SS')
  and sample_time <= to_timestamp('$T2','YYYY-MM-DD HH24:MI:SS')
  $IL
