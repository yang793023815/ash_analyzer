set heading off feedback off pages 0
select 'ASH_HOME_OK' from dual;
exit
TE
)
      case "$_tst" in *ASH_HOME_OK*) export ORACLE_HOME="$hh"; break ;; esac
    else
      export ORACLE_HOME="$hh"; break
    fi
  done
fi
[ -z "$ORACLE_HOME" ] && { log "!! 无法确定 ORACLE_HOME: 请先 . oraenv"; exit 1; }
[ -z "$ORACLE_SID" ] && { log "!! 无法确定 ORACLE_SID : 请先 . oraenv"; exit 1; }
