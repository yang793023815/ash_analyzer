#!/bin/bash
#=====================================================================
# ash_analyzer v1.3 -- Oracle ASH 历史性能 / 阻塞分析工具
#                      (RAC + 单实例; 11.2.0.4 ~ 19c+)
#
# v1.3 (2026-09-30):
#   - 命令分派 case 合并 text (修复 text 分支顺序依赖)
#   - chain path 列 a40 -> a60 + rpad, 消除跨实例长链换行串行
#   - events/all 事件列 a40 -> a35/a38, 消除 'flash cache' 折行串行
#   - -p N 新增会话级并行 (alter session force parallel query)
#   - connect by 边加固: 排除 BLOCKING_SESSION_STATUS='INVALID' 的历史行
#     (同实例边强制 prior inst=inst, 语义更显式)
#   - 新增 export 命令: 交互输入时间范围, 生成客户环境信息收集脚本
#     (CTAS ash/对象/SQL文本/用户 四件套 + expdp 打包, 拷过去直接执行)
#   - 新增 diag 命令: 生成客户侧自诊断脚本 (无法导 dmp / 无法远程时,
#     客户输入视图名+时间窗, 本地跑六步法输出初步排查报告报告)
#
# 跨环境导入分析: -i 指定任意导入表/视图 (布局自动识别);
#   -objmap/-sqlmap/-usermap 配套解析对象名/SQL文本/用户名;
#   数据 DBID 与本地不一致时自动提示。
#
# 数据源 (自动识别布局, 或用 -i 指定):
#   gv$active_session_history      RAC 全库, 内存, 1s 采样
#   v$active_session_history       本实例, 内存, 1s 采样
#   dba_hist_active_sess_history   AWR 持久化, 10s 采样
#   任意 CTAS / impdp 导入的 ASH 表   布局按列自动识别
#
# 布局识别:
#   有 INST_ID                   -> gv     (采样间隔 1s)
#   有 SNAP_ID + INSTANCE_NUMBER -> hist   (采样间隔 10s)
#   有 INSTANCE_NUMBER (无 SNAP_ID/DBID) -> hist + 提示
#   都没有                       -> single
# 可选列缺失自动降级 -> 11.2 / 12c / 19c 列集差异安全.
#
# 阻塞链 (connect by 向上走: 受害者 -> 持有者 -> ...):
#   同实例边  : 精确样本匹配 (sample_id / sample_time)
#   跨实例边  : 时间容差 (RAC 两实例采样网格相位差, 无法等值匹配;
#               默认 hist 5s / gv 2s, -w 可调; 已在 12.1 RAC 实测标定)
#
# 时间口径: DB time ~= ASH 样本数 x 采样间隔
#
# 部署: 任意装有 bash + sqlplus 的 Oracle 服务器, 单文件, 无其他依赖
# by AutoClaw for 飞扬, 2026-09-22
#=====================================================================
VERSION="1.5"

#---------------------------------------------------------------------
# defaults
#---------------------------------------------------------------------
TOPN=15
MINS=""
TBEG=""
TEND=""
VIEW_IN=""
OBJMAP=""
SQLMAP=""
USERMAP=""
PDB=""
CONN=""
SID_IN=""
SPOOLF=""
SESSID=""
SQLID=""
INSTF=""
DBIDF=""
CONF=""
PDOP=""
MINSAMP=6
XTOL=""
VERBOSE=0
CMD=""

RV_FULL=""        # 解析后的 owner.object
RV_KIND=""        # gv | hist | single
ICOL="1"          # 实例列表达式
ICOLN="1"         # 实例列裸名 (single 时为常量 1)
IV=1              # 采样间隔(秒, 估计)
COLS=""           # 列清单(空格分隔)
SMATCH=""         # 样本匹配表达式
SMATCH_T=""       # 样本匹配表达式(to_char 形态)
CRM=""            # connect_by_root(样本列)
CRINST=""         # connect_by_root(实例列) 或 1
CBSER=""          # serial# 匹配条件
CB=""             # 完整 connect by 条件
TW=""             # 时间窗口 where 片段
TW_DESC=""
PHINT=""          # 并行 hint 内容
SQLBIN=""

#---------------------------------------------------------------------
# helpers
#---------------------------------------------------------------------
die() { echo "ERROR: $*" >&2; exit 1; }
vmsg() { if [ "$VERBOSE" = "1" ]; then echo "-- $*" >&2; fi; }

valid_ts()   { echo "$1" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$'; }
valid_int()  { echo "$1" | grep -qE '^[0-9]+$'; }
valid_qual() { echo "$1" | grep -qE '^[A-Za-z][A-Za-z0-9_$#]*(\.[A-Za-z][A-Za-z0-9_$#]*)?$'; }
valid_sqlid(){ echo "$1" | grep -qE '^[0-9a-z]{13}$'; }

has_col() { case " $COLS " in *" $1 "*) return 0;; esac; return 1; }
numcol()  { if has_col "$1"; then echo "$1"; else echo "to_number(null)"; fi; }
strcol()  { if has_col "$1"; then echo "$1"; else echo "to_char(null)"; fi; }

# 原始 SQL 执行 (字符串只做一次 shell 展开, 经管道喂给 sqlplus)
qsql() {
  {
    if [ -n "$PDB" ]; then echo "alter session set container=\"$PDB\";"; fi
    printf '%s\n' "$1"
  } | "$SQLBIN" -S -L "$CONN"
}

#---------------------------------------------------------------------
# usage
#---------------------------------------------------------------------
usage() {
echo "ash_analyzer v$VERSION -- Oracle ASH 历史性能 / 阻塞分析工具"
cat <<'U'
               支持 RAC 与单实例; 11.2.0.4 ~ 19c; 内存视图 + AWR 历史 + 导入表

用法:
  ./ash_analyzer                  或  ./ash_analyzer help      # 本帮助 (总览)
  ./ash_analyzer <命令> -help                                 # 命令级详细帮助
  ./ash_analyzer <命令> [选项]                                  # 执行

命令 (详细用法敲: ./ash_analyzer <命令> -help)
  --- 分析命令 (在本机库上跑) ---
  info       数据源体检: 布局识别/行数/时间范围/各实例分布/密度/采样断档
  trend      活动会话趋势: 每分钟直方 + 峰值样本
  events     顶级等待事件 (含 ON CPU) + 事件 x SQL 交叉
  sql        SQL 排行 (按样本数) + 长执行识别 (sql_exec_id)
  sessions   会话排行 (解析用户/程序/机器)
  blockers   阻塞分析: 直接阻塞者 + 根阻塞者 Root Blocker (等待树)
  chain      等待链树; 加 -S 追踪单会话的向上等待链
  detail     单会话 ASH 时间线 + seq# 停滞分析 (-S 必填)
  obj        热点对象 (current_obj#)
  res        PGA / 临时表空间消耗 (按 SQL)
  text       打印 SQL 文本 (text -q <sql_id>)
  all        一键复盘报告 (范围+峰值+事件+SQL+会话+阻塞)
  --- 生成命令 (产出脚本给客户环境用) ---
  export     生成客户环境 ASH 信息收集脚本 (CTAS 四件套 + expdp 打包)
  diag       生成客户侧自诊断脚本 (导不出 dmp / 无法远程时用)

数据源 -i  [默认 hist]
  gv / v / hist / 任意表名或视图名 (布局自动识别, 可带属主, 如 -i wfy.m_ash)

通用速查 (全部选项见各命令的 -help):
  -t/-T 窗口    -m N 最近N分钟    -i 数据源    -c 连接串    -s SID    -n TopN
  -f 落盘       -v 打印SQL        -V 版本

方法论 (MOS 经典六步的命令化):
  info/trend 定位窗口 -> events 看症状 -> blockers 找根持有者
  -> chain -S <root_sid> 看链路 -> detail -S 看 seq# 停滞 -> obj/res 补充

配置文件 (可选): 脚本同目录 ash_analyzer.conf 预置默认值, CLI 参数优先.
U
}

#---- 命令级帮助 -------------------------------------------------------
usage_cmd() {
  case "$1" in
    info)
cat <<'H'
info -- 数据源体检
  布局识别 (hist 10s / gv 1s / 单实例), 行数, 时间范围, 各实例分布,
  每实例样本密度, 采样断档 (时间线上的空窗, 如 AWR flush 期间).
  info 始终全表扫描, 不受 -m/-t/-T 过滤.
用法: ./ash_analyzer info [-i 数据源] [-c 连接串] [-s SID] [-g N] [-D DBID]
示例: ./ash_analyzer info
      ./ash_analyzer info -i gv
      ./ash_analyzer info -i wfy.m_ash_20260929 -s panjf1
H
      ;;
    trend)
cat <<'H'
trend -- 活动会话趋势
  每分钟会话数直方 (含 ON CPU), 峰值分钟与峰值时刻样本明细.
  用来定位故障时间窗, 再用 -t/-T 精确分析.
用法: ./ash_analyzer trend [-i 数据源] [-m N | -t .. -T ..] [-g N] [-n N]
示例: ./ash_analyzer trend -m 120
      ./ash_analyzer trend -t '2026-09-29 15:00:00' -T '2026-09-29 17:59:00'
H
      ;;
    events)
cat <<'H'
events -- 顶级等待事件
  按样本数排序的等待事件 (含 ON CPU), 附事件 x SQL 交叉表,
  区分集群类等待 (gc *) 与单实例等待, 快速判断是集群扩散还是本地问题.
用法: ./ash_analyzer events [-i 数据源] [窗口选项] [-g N] [-n N]
示例: ./ash_analyzer events -t '2026-09-29 15:00:00' -T '2026-09-29 17:59:00'
H
      ;;
    sql)
cat <<'H'
sql -- SQL 排行
  按样本数排序的 SQL Top N, 识别长执行 (sql_exec_id 相同跨多采样点),
  附 SQL 类型 (SELECT/PLSQL...) 与用户/模块.
  -q <sql_id> 看单条: 配 text 命令取文本.
用法: ./ash_analyzer sql [-i 数据源] [窗口选项] [-g N] [-n N] [-x N]
  -x N    长执行判定阈值样本数 (默认 6)
示例: ./ash_analyzer sql -m 60 -n 20
H
      ;;
    sessions)
cat <<'H'
sessions -- 会话排行
  按样本数排序的会话 Top N, 解析用户/程序/机器,
  跨环境导入数据需配 -usermap (user_id 属于源库).
用法: ./ash_analyzer sessions [-i 数据源] [窗口选项] [-g N] [-n N] [-usermap 表]
示例: ./ash_analyzer sessions -m 60
      ./ash_analyzer sessions -i system.t_ash -usermap system.t_users
H
      ;;
    blockers)
cat <<'H'
blockers -- 阻塞分析 (直接阻塞者 + 根阻塞者)
  Root Blocker 视角: 谁"持有资源不撒手"导致整棵等待树.
  输出根阻塞者清单 (isleaf=1 的持有者) + 其 root_evt (它自己在等什么,
  即真正的最终原因: 如 idle = 纯持有不干活, 如 enq HW = 它也是受害者).
  每个根阻塞者给出其下受害树规模.
  大窗口建议 -p N (强制并行, 1.1M 行 45 分钟窗约 2-4 分钟).
用法: ./ash_analyzer blockers [-i 数据源] [窗口选项] [-g N] [-p N]
示例: ./ash_analyzer blockers -t '2026-09-29 16:00:00' -T '2026-09-29 17:00:00' -p 4
H
      ;;
    chain)
cat <<'H'
chain -- 等待链树
  CONNECT BY 向上走 blocking_session, 还原"谁堵谁"的完整链条,
  iscycle 标记环 (AB 互堵), 跨实例边 (gc 类等待) 有 5s 相位容差.
  -S <sid> 只看一个会话的向上链路 (从受害者追到根).
  大窗口建议 -p N. 注意: -g N 会切断跨实例等待链, 慎用.
用法: ./ash_analyzer chain [-i 数据源] [窗口选项] [-S SID] [-g N] [-p N] [-w N]
  -S SID  追踪单会话等待链
  -w N    跨实例链匹配容差秒 (默认 hist=5 / gv=2)
示例: ./ash_analyzer chain -S 12345 -m 30
      ./ash_analyzer chain -t '2026-09-29 16:40:00' -T '2026-09-29 16:50:00'
H
      ;;
    detail)
cat <<'H'
detail -- 单会话 ASH 时间线
  一个会话逐采样点明细: 事件/p1p2/对象/SQL; seq# 长期不变 = 会话卡死
  (区别于采样间隙). p1/p2 自动按事件解码 (HW: 表空间# 文件#/块#,
  TX: usn/slot...).
  注意: blocker 的 SID 是每实例编号, RAC 下可能要按实例分别 detail.
用法: ./ash_analyzer detail -S SID [-i 数据源] [窗口选项] [-g N]
示例: ./ash_analyzer detail -S 12345 -m 60
H
      ;;
    obj)
cat <<'H'
obj -- 热点对象
  按 current_obj# 统计热点表/索引; 跨环境导入数据 (obj# 属源库) 必须
  配 -objmap (源库 dba_objects 的 CTAS 映射表), 否则只能看到裸 object_id.
用法: ./ash_analyzer obj [-i 数据源] [窗口选项] [-objmap 表] [-n N]
示例: ./ash_analyzer obj -i system.t_ash -objmap system.t_obj -t '..' -T '..'
H
      ;;
    res)
cat <<'H'
res -- 资源消耗
  按 SQL 统计 PGA / 临时表空间消耗 (TEMPSEG_SIZE/PGA_ALLOCATED_MEM),
  定位排序/哈希/大数据量 SQL.
用法: ./ash_analyzer res [-i 数据源] [窗口选项] [-g N] [-n N]
示例: ./ash_analyzer res -m 60
H
      ;;
    text)
cat <<'H'
text -- 打印 SQL 文本
  跨环境导入数据 (SQL 文本属源库) 需配 -sqlmap, 否则只能显示 SQL_ID.
用法: ./ash_analyzer text -q <sql_id> [-i 数据源] [-sqlmap 表]
示例: ./ash_analyzer text -q 3ajt2htrmb83y
      ./ash_analyzer text -q 3ajt2htrmb83y -sqlmap system.t_sqltext
H
      ;;
    all)
cat <<'H'
all -- 一键复盘报告
  依次跑: 窗口概览 + 峰值 + 事件 + SQL + 会话 + 阻塞, 汇总一份报告;
  建议配 -f 落盘存档.
用法: ./ash_analyzer all [-i 数据源] [窗口选项] [-n N] [-p N] [-f 文件]
示例: ./ash_analyzer all -t '2026-09-29 15:00:00' -T '2026-09-29 17:59:00' -f rep.txt
H
      ;;
    export)
cat <<'H'
export -- 生成客户环境信息收集脚本
  场景: 能进客户库但要带数据回分析机 (导不出 dmp 也能收集).
  生成一个自包含收集脚本, 拷到客户环境执行:
    CTAS 四件套 (m_ash/m_obj/m_sqltext/m_users + m_snap) -> expdp 打包 dmp ->
    清理临时表; 拿回 dmp impdp 后用 ./ash_analyzer info -i <owner>.m_ash_<tag> 分析.
  生成的脚本 sh/bash 均可执行, 自带环境自举 (ORACLE_HOME 未设也能跑),
  预校验临时表用户/directory 存在, 幂等可重跑.
选项:
  -t 'YYYY-MM-DD HH24:MI:SS'   窗口起点 (不给则交互输入)
  -T 'YYYY-MM-DD HH24:MI:SS'   窗口终点 (不给则交互输入)
  -o FILE    收集脚本落盘路径 (默认 /tmp/ash_collect_<tag>.sh)
  -s SID     目标库 ORACLE_SID (多实例主机建议显式指定)
  -c STR     客户库连接串 (默认 / as sysdba), 会写进生成的脚本
  -g N       只收集实例 N (默认全部实例)
  -d DIR     导出用 Oracle directory 名 (默认 DATA_PUMP_DIR)
  -u USER    CTAS 临时表存放用户 (默认 system; 需有建表权限+配额,
             以及 directory 读写权限: grant read,write on directory <DIR> to <USER>)
示例: ./ash_analyzer export
      ./ash_analyzer export -t '2026-10-01 10:00:00' -T '2026-10-01 11:00:00' \
                             -o /tmp/ash_collect.sh -s orcl1 -u wfy -d EXP_DUMP
H
      ;;
    diag)
cat <<'H'
diag -- 生成客户侧自诊断脚本
  场景: 无法远程 / 导不出 dmp, 客户在自己环境跑初诊.
  生成自包含诊断脚本 (不依赖 ash_analyzer), 客户执行时输入:
    ASH 视图/表名 + 时间窗 (回车沿用上次, 记在 ash_diag_run.conf);
  脚本自动识别布局, 按 MOS 六步法输出初步排查报告 diag_report_<tag>.txt.
  输出简洁 (进度行 + 报告摘要), 可反复调整时间窗重跑.
选项:
  -t/-T      时间范围 (不给则由客户执行时交互输入)
  -i VIEW    客户侧数据源 (默认 dba_hist_active_sess_history)
  -o FILE    生成脚本落盘路径 (默认 /tmp/ash_diag_<tag>.sh)
  -c STR     客户库连接串 (默认 / as sysdba)
示例: ./ash_analyzer diag
      ./ash_analyzer diag -t '2026-10-08 00:00:00' -T '2026-10-08 01:00:00'
H
      ;;
    *)
      echo "没有 '$1' 命令的单独帮助; 敲 ./ash_analyzer help 看总览." >&2
      usage
      ;;
  esac
}

#---------------------------------------------------------------------
# 可选配置文件: 脚本同目录 ash_analyzer.conf (KEY=*** CLI 参数优先)
#   可预置: VIEW_IN / CONN / TOPN / MINS / SPOOLF / PDOP / VERBOSE
#---------------------------------------------------------------------
CONF_FILE="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/ash_analyzer.conf"
[ -f "$CONF_FILE" ] && . "$CONF_FILE"

#---------------------------------------------------------------------
# 参数解析
#---------------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    info|trend|events|sql|sessions|blockers|chain|detail|obj|res|all|text|export|diag)
         CMD="$1"; shift ;;
    help) usage; exit 0 ;;
    -V|--version) echo "ash_analyzer v$VERSION"; exit 0 ;;
    -help|-h|--help) [ -n "$CMD" ] && { usage_cmd "$CMD"; exit 0; }; usage; exit 0 ;;
    -t) TBEG="$2"; shift 2 ;;
    -T) TEND="$2"; shift 2 ;;
    -m) MINS="$2"; shift 2 ;;
    -i) VIEW_IN="$2"; shift 2 ;;
    -objmap) OBJMAP="$2"; shift 2 ;;
    -sqlmap) SQLMAP="$2"; shift 2 ;;
    -usermap) USERMAP="$2"; shift 2 ;;
    -pdb) PDB="$2"; shift 2 ;;
    -c) CONN="$2"; shift 2 ;;
    -s) SID_IN="$2"; shift 2 ;;
    -n) TOPN="$2"; shift 2 ;;
    -g) INSTF="$2"; shift 2 ;;
    -D) DBIDF="$2"; shift 2 ;;
    -C) CONF="$2"; shift 2 ;;
    -f) SPOOLF="$2"; shift 2 ;;
    -p) PDOP="$2"; shift 2 ;;
    -x) MINSAMP="$2"; shift 2 ;;
    -w) XTOL="$2"; shift 2 ;;
    -S) SESSID="$2"; shift 2 ;;
    -q) SQLID="$2"; shift 2 ;;
    -o) OUTF="$2"; shift 2 ;;
    -d) DPDIR="$2"; shift 2 ;;
    -u) TOWNER="$2"; shift 2 ;;
    -v) VERBOSE=1; shift ;;
    *) if [ "$CMD" = "text" ] && [ -z "$SQLID" ] && valid_sqlid "$1"; then
         SQLID="$1"; shift
       else
         echo "未知参数: $1" >&2; usage; exit 1
       fi ;;
  esac
done

[ -z "$CMD" ] && { usage; exit 1; }

[ -n "$TBEG" ] && { valid_ts "$TBEG"  || die "-t 需要 'YYYY-MM-DD HH24:MI:SS'"; }
[ -n "$TEND" ] && { valid_ts "$TEND"  || die "-T 需要 'YYYY-MM-DD HH24:MI:SS'"; }
[ -n "$OUTF"  ] && case "$CMD" in export|diag) : ;; *) die "-o 仅 export/diag 命令使用" ;; esac
[ -n "$MINS" ] && { valid_int "$MINS" || die "-m 需要数字"; }
valid_int "$TOPN"    || die "-n 需要数字"
valid_int "$MINSAMP" || die "-x 需要数字"
[ -n "$INSTF"  ] && { valid_int "$INSTF"  || die "-g 需要数字"; }
[ -n "$DBIDF"  ] && { valid_int "$DBIDF"  || die "-D 需要数字"; }
[ -n "$CONF"   ] && { valid_int "$CONF"   || die "-C 需要数字"; }
[ -n "$PDOP"   ] && { valid_int "$PDOP"   || die "-p 需要数字"; }
[ -n "$XTOL"   ] && { valid_int "$XTOL"   || die "-w 需要数字"; }
[ -n "$SESSID" ] && { valid_int "$SESSID" || die "-S 需要会话号"; }
[ -n "$SQLID"  ] && { valid_sqlid "$SQLID" || die "-q 需要 13 位 sql_id"; }
[ -n "$PDB"   ] && { valid_qual "$PDB"   || die "-pdb 需要合法容器名"; }
[ "$CMD" = "detail" ] && [ -z "$SESSID" ] && die "detail 必须带 -S <session_id>"
[ "$CMD" = "text"   ] && [ -z "$SQLID"  ] && die "text 用法: text -q <sql_id>"

if [ -n "$SPOOLF" ]; then
